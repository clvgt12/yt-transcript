# yt-transcribe-web environment variables
# Copy to .env and fill in your values

# Ollama cloud API key (leave blank to use local model only)
OLLAMA_API_KEY=

# Transcription defaults
WHISPER_MODEL=small
FORCE_WHISPER=false

# Summarization defaults
SUMMARIZE=true
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_CLOUD_MODEL=gpt-oss:120b
FORCE_LOCAL_SUMMARY=false

# Agentic web search parameters to support follow up questions
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3

# Default context window size for local Ollama hosted models
OLLAMA_CONTEXT_LENGTH=8192

# UI polling interval in milliseconds
POLL_INTERVAL_MS=2000

# Cache expiry in days (0 = disabled, default 30)
CACHE_FILE_AGE_DAYS=30

