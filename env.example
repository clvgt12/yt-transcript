# yt-transcribe-web environment variables
# Copy to .env and fill in your values

# Uncomment these lines to force local transcription via whisper
#FORCE_WHISPER=true
#WHISPER_MODEL=base
# Transcription output language: 'auto' (default) transcribes in the
# detected source language; 'en' translates any source language to
# English. Whisper cannot translate to any other target language.
#TARGET_LANG=auto
#WHISPER_POLL_INTERVAL=3

# Ollama API key — required for web_search / web_fetch tool execution
# Get yours at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Summarization — all requests route through local Ollama server
# Cloud models (ending in -cloud) are proxied transparently to ollama.com
OLLAMA_PRIMARY_MODEL=gpt-oss:120b-cloud
OLLAMA_FALLBACK_MODEL=qwen3:1.7b
# Uncommenting either of these will force the use of the local "fallback" model for summarization
#FORCE_LOCAL_SUMMARY=true
#OLLAMA_NO_CLOUD=1
# Agentic web search for follow-up questions
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3
# Specify the local Ollama model's context window (tokens)
OLLAMA_CONTEXT_LENGTH=24576
# Web UI polling interval in milliseconds
POLL_INTERVAL_MS=2000
# Whisper job hard timeout in seconds (default 10 min)
JOB_TIMEOUT_SECONDS=600

# Cache expiry in days (0 = disabled)
CACHE_FILE_AGE_DAYS=7
